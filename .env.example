# 复制这份文件为 .env，按需填写；.env 本身已加入 .gitignore，不会被提交。

# ── LLM（必填）───────────────────────────────────────────────
# 默认接 DeepSeek（国内直连、价格便宜），去 https://platform.deepseek.com 申请 key。
LLM_API_KEY=
# 换其他 OpenAI 兼容服务（Kimi / 通义 / 自建网关）时才需要改下面两个：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ── 投递渠道（按 config.yaml 的 delivery.channel 选一个配）────
# channel: gmail
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_TO=

# channel: feishu
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# channel: local 不需要任何凭据，只写本地 digest.md
